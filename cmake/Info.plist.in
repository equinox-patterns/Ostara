			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ostara.ostara.cartouche</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ostara piece</string>
			<key>CFBundleTypeIconFile</key>
			<string>Ostara.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ostara.ostara.piece</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ostara watermark</string>
			<key>CFBundleTypeIconFile</key>
			<string>Ostara.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ostara.ostara.watermark</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ostara pattern recipe</string>
			<key>CFBundleTypeIconFile</key>
			<string>Ostara.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ostara.ostara.recipe</string>
			</array>
		</dict>
	</array>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
		<string>de</string>
		<string>el</string>
		<string>es</string>
		<string>fi</string>
		<string>fr</string>
		<string>hr</string>
		<string>hu</string>
		<string>id</string>
		<string>it</string>
		<string>ja</string>
		<string>nl</string>
		<string>pl</string>
		<string>pt</string>
		<string>ro</string>
		<string>uk</string>
		<string>zh</string>
	</array>

	<!--
	  La catégorie de l'application : la métadonnée qu'Apple attend de tout paquet, que Launchpad et
	  le magasin lisent, et qui manquait ici. `graphics-design` est la famille d'un outil de dessin de
	  patrons.
	  ⚠️ Ce n'est PAS ce qui cachait Ostara de la liste d'applications : la cause était les quatre
	  bundles de build portant le même identifiant, enregistrés en même temps que celui des
	  Applications. La catégorie est juste, mais elle n'a rien réparé.
	-->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

</dict>
</plist>
