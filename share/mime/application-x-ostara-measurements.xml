<?xml version="1.0" encoding="UTF-8"?>
<!-- Le type de fichier, côté Linux : sans cette déclaration, un .measurements reste un fichier
     inconnu pour le gestionnaire de fichiers — aucune icône, aucun « ouvrir avec ». -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ostara-measurements">
    <comment>Ostara measurements table</comment>
    <comment xml:lang="fr">Tableau de mesures Ostara</comment>
    <sub-class-of type="text/xml"/>
    <generic-icon name="application-x-ostara-measurements"/>
    <glob pattern="*.omt"/>
    <glob pattern="*.otu"/>
  </mime-type>
</mime-info>
