/* ── Ostara — Ostara (generated from palette.json) ── */

/* ===== WelcomeScreen ===== */

/* Fond de la fenêtre d'accueil */
QWidget#welcomeScreen {
    background-color: $fond_fenetre;
}

/* Titre "Ostara" */
QLabel#welcomeTitle {
    font-size: 32px;
    font-weight: bold;
    color: $texte_principal;
}

/* Numéro de version */
QLabel#welcomeVersion {
    font-size: 12px;
    color: $texte_secondaire;
}

/* Sous-titre */
QLabel#welcomeSubtitle {
    font-size: 15px;
    color: $texte_secondaire;
}

/* Cartes des sections */
QFrame#welcomeSection {
    background-color: $fond_panneau;
    border: 1px solid $bordure;
    border-radius: 4px;
}

/* Titre de section */
QLabel#welcomeSectionTitle {
    font-size: 13px;
    font-weight: bold;
    color: $texte_principal;
}

/* Bouton "Nouveau" */
QPushButton#welcomeNewBtn {
    background-color: $fond_fenetre;
    color: $texte_principal;
    border: 1px solid $bordure;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeNewBtn:hover {
    background-color: $accent;
    color: $accent_texte;
}

/* Bouton "Ouvrir" */
QPushButton#welcomeOpenBtn {
    background-color: $fond_fenetre;
    color: $texte_principal;
    border: 1px solid $bordure;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeOpenBtn:hover {
    background-color: $accent;
    color: $accent_texte;
}

/* Label "Récents" */
QLabel#welcomeRecentLabel {
    font-size: 11px;
    color: $texte_secondaire;
}

/* Liste des récents */
QListWidget#welcomeRecentList {
    background-color: $fond_panneau;
    border: 1px solid $bordure;
    border-radius: 2px;
}
QListWidget#welcomeRecentList::item {
    padding: 4px 8px;
    color: $texte_principal;
}
QListWidget#welcomeRecentList::item:hover {
    background-color: $selection_fond;
}
QListWidget#welcomeRecentList::item:selected {
    background-color: $accent;
    color: $accent_texte;
}

/* Placeholder Favoris */
QLabel#welcomeFavPlaceholder {
    font-size: 13px;
    color: $texte_secondaire;
}
