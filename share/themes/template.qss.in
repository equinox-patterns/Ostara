/* ── Ostara — generated from palette.json ── */
/* ⚠️  DO NOT EDIT — this file is generated from template.qss.in + palette.json  */
/*     Run: python3 scripts/generate_themes.py share/themes/palette.json            */
/*          share/themes share/themes/generated                                     */
/*                                                                                  */
/* Icons: indicators and arrows use SVG images from /icons/ via $theme substitution.
   See design-system.md §6 for QScrollArea viewport (C++ workaround, not QSS). */

/* =========================================================================
   GLOBAL — Police de base (Inter, 15px)
   ========================================================================= */

QWidget {
    font-family: "Inter";
    font-size: 15px;
}

/* =========================================================================
   QToolTip
   ========================================================================= */

QToolTip {
    background-color: $Window;
    color: $Text;
    border: 1px solid $Border;
    border-radius: 2px;
    padding: 4px 8px;
    font-size: 13px;
}

/* =========================================================================
   MAIN WINDOW / DIALOG — Fond principal
   ========================================================================= */

QMainWindow {
    background-color: $Window;
}

QDialog {
    background-color: $DialogBg;
}

/* =========================================================================
   QMenuBar — Barre de menus système
   Design: $MenuBar background, 1px $Border bottom separator
   ========================================================================= */

QMenuBar {
    background-color: $MenuBar;
    color: $Text;
    border-bottom: 1px solid $Border;
    padding: 1px 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: $HoverBg;
}

QMenuBar::item:pressed {
    background-color: $PressedBg;
}

/* =========================================================================
   QMenu — Menus déroulants
   Design: $Window background, $Accent highlight on selected items
   ========================================================================= */

QMenu {
    background-color: $Window;
    color: $Text;
    border: 1px solid $Border;
    padding: 4px 0px;
}

QMenu::item {
    padding: 5px 30px 5px 12px;
}

QMenu::item:selected {
    background-color: $Accent;
    color: $AccentText;
}

QMenu::item:disabled {
    color: $TextDisabled;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: $Border;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* =========================================================================
   QToolBar — Barres d'outils (TopBar, ToolBar latérale, etc.)
   Design: $ToolBar background, $Border separators
   ========================================================================= */

QToolBar {
    background-color: $ToolBar;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background: $Border;
    width: 1px;
    margin: 4px 4px;
}

/* =========================================================================
   QStatusBar — Barre de statut
   Design: $StatusBar background, $TextSecondary for text, 13px labels
   ========================================================================= */

QStatusBar {
    background-color: $StatusBar;
    color: $TextSecondary;
    border-top: 1px solid $Border;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: $TextSecondary;
    font-size: 13px;
    padding-left: 30px;
}

/* =========================================================================
   QPushButton — Boutons standards
   Design: flat, $ButtonBg at rest → $Accent on hover/pressed/default
   Disabled: $TextDisabled + $BorderLight
   ========================================================================= */

QPushButton {
    background-color: $ButtonBg;
    color: $Text;
    border: 1px solid $Border;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton:hover,
QPushButton:pressed,
QPushButton:default {
    background-color: $Accent;
    color: $AccentText;
    border-color: $Accent;
}

QPushButton:disabled {
    background-color: $ButtonBg;
    color: $TextDisabled;
    border-color: $BorderLight;
}

/* État sélectionné (QPushButton checkable — presets de longueur, Simple/Double, …)
   Fond de sélection + bordure accent, cohérent avec QToolButton:checked. */
QPushButton:checked {
    background-color: $SelectionBg;
    color: $Text;
    border: 1px solid $Accent;
}

QPushButton:checked:hover {
    background-color: $SelectionBg;
    color: $Text;
    border: 1px solid $Accent;
}

/* Variante : bouton icône seule (Phosphor, transparent, sans bordure) */
QPushButton#phosphorIconBtn {
    background: transparent;
    border: none;
    padding: 0px;
    color: $TextSecondary;
}

QPushButton#phosphorIconBtn:hover {
    background: transparent;
    color: $Accent;
}

QPushButton#phosphorIconBtn:pressed {
    background: transparent;
    color: $AccentHover;
}

QPushButton#phosphorIconBtn:disabled {
    background: transparent;
    color: $TextDisabled;
}

/* =========================================================================
   QToolButton — Boutons d'outils (toolbar, popup, dialog fx buttons)
   Design: transparent rest → $HoverBg hover → $SelectionBg + $Accent border when checked
   Variant #drawToolBtn: larger border-radius, $SelectionBg on hover/checked
   ========================================================================= */

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    color: $TextSecondary;
}

QToolButton:hover {
    background: $HoverBg;
    color: $Text;
}

QToolButton:pressed {
    background: $PressedBg;
}

QToolButton:checked {
    background: $SelectionBg;
    border-color: $Accent;
    color: $Text;
}

QToolButton:disabled {
    color: $TextDisabled;
}

/* Menu indicator (flèche de popup — VToolButtonPopup) */
QToolButton::menu-indicator {
    image: none;
}

QToolButton::menu-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    width: 16px;
}

QToolButton::menu-button:hover {
    background: $HoverBg;
}

QToolButton::menu-arrow {
}

/* Variante : bouton toolbar draw (design-system.md §4 — DrawToolBar) */
QToolButton#drawToolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}

QToolButton#drawToolBtn:hover {
    background: $SelectionBg;
}

QToolButton#drawToolBtn:checked {
    background: $SelectionBg;
    border-color: $Accent;
}

QToolButton#drawToolBtn:disabled {
    color: $TextDisabled;
}

/* =========================================================================
   QLineEdit / QPlainTextEdit — Champs texte
   Design: $InputBg background, $InputFocus border on focus
   Selection: $Accent + $AccentText
   ========================================================================= */

QLineEdit,
QPlainTextEdit {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: $Accent;
    selection-color: $AccentText;
}

QLineEdit:focus,
QPlainTextEdit:focus {
    border-color: $InputFocus;
}

QLineEdit:read-only,
QPlainTextEdit:read-only {
    background-color: $InputBg;
}

QLineEdit:disabled,
QPlainTextEdit:disabled {
    color: $TextDisabled;
    border-color: $BorderLight;
}

/* Checkbox field — container styled as an input field */
#checkField {
    background-color: $InputBg;
    border: 1px solid $InputBorder;
    border-radius: 2px;
}

/* =========================================================================
   QSpinBox / QDoubleSpinBox — Champs numériques
   Design: like QLineEdit + custom up/down buttons (all-or-nothing rule)
   ========================================================================= */

QSpinBox,
QDoubleSpinBox {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 4px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: $InputFocus;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: $TextDisabled;
    border-color: $BorderLight;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid $InputBorder;
    border-bottom: 1px solid $InputBorder;
    border-top-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: none;
    border-left: 1px solid $InputBorder;
    border-bottom-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: $HoverBg;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: $SelectionBg;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/$theme/caret-up_$theme.svg);
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url(:/icons/$theme/caret-up_accent.svg);
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url(:/icons/$theme/caret-up_disabled.svg);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/$theme/caret-down_$theme.svg);
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url(:/icons/$theme/caret-down_accent.svg);
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url(:/icons/$theme/caret-down_disabled.svg);
}

/* =========================================================================
   #zoomBlock — Glued zoom control [−] [100%] [+]
   ========================================================================= */

#zoomBlockBtnLeft {
    padding: 1px 6px;
    border: 1px solid $InputBorder;
    border-right: none;
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    background: $InputBg;
}

#zoomBlockBtnRight {
    padding: 1px 6px;
    border: 1px solid $InputBorder;
    border-left: none;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    background: $InputBg;
}

#zoomBlockBtnLeft:hover,
#zoomBlockBtnRight:hover {
    background: $HoverBg;
}

#zoomBlockBtnLeft:pressed,
#zoomBlockBtnRight:pressed {
    background: $PressedBg;
}

#zoomBlockSpin {
    border: 1px solid $InputBorder;
    border-left: none;
    border-right: none;
    border-radius: 0;
    background: $InputBg;
}

#zoomBlockSpin:focus {
    border-color: $Accent;
}

/* =========================================================================
   QComboBox — Listes déroulantes (all-or-nothing rule)
   Design: like an input + transparent drop-down + $Accent hover border
   ========================================================================= */

QComboBox {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 5px 8px;
}

QComboBox:hover {
    border-color: $Accent;
}

QComboBox:focus {
    border-color: $InputFocus;
}

QComboBox:disabled {
    color: $TextDisabled;
    border-color: $BorderLight;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid $InputBorder;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/$theme/caret-down_$theme.svg);
}

QComboBox::down-arrow:hover {
    image: url(:/icons/$theme/caret-down_accent.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/$theme/caret-down_disabled.svg);
}

/* Popup list */
QComboBox QAbstractItemView {
    background-color: $InputBg;
    color: $Text;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: $TableRowBg;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: $TableRowHoverBg;
    color: $AccentText;
}

QComboBox QAbstractItemView::item:selected {
    background-color: $Accent;
    color: $AccentText;
}

/* =========================================================================
   QAbstractItemView — Vues d'items communes (QListWidget, QTreeView, QTableWidget, etc.)
   Design: $InputBg background, no borders. Separation by color only.
   Selected → $Accent + $AccentText. Hover → $TableRowHoverBg.
   ⚠️  Exception QComboBox in cells: hover must be disabled on those rows
       (not expressible in QSS — handled in C++, see design-system.md §3).
   ========================================================================= */

QAbstractItemView {
    background-color: $InputBg;
    alternate-background-color: $TableRowAltBg;
    color: $Text;
    border: none;
    outline: none;
    selection-background-color: $Accent;
    selection-color: $AccentText;
}

QAbstractItemView::item {
    background-color: $TableRowBg;
    border: none;
    padding: 4px 8px;
}

QAbstractItemView::item:alternate {
    background-color: $TableRowAltBg;
}

QAbstractItemView::item:hover {
    background-color: $TableRowHoverBg;
    color: $AccentText;
}

QAbstractItemView::item:selected {
    background-color: $Accent;
    color: $AccentText;
}

/* =========================================================================
   QTreeView — Branches (expand/collapse arrows)
   Drawn natively by Fusion — no SVG images
   ========================================================================= */

/* =========================================================================
   QHeaderView — En-têtes de tables / arbres
   Design: $TableHeaderBg background, no top/left border, subtle right/bottom
   ========================================================================= */

QHeaderView::section {
    background-color: $TableHeaderBg;
    color: $Text;
    border: none;
    border-right: 1px solid $BorderLight;
    border-bottom: 1px solid $Border;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: $HoverBg;
}

/* =========================================================================
   QCheckBox / QRadioButton
   Design: SVG indicators from /icons/$theme/
   ========================================================================= */

QCheckBox,
QRadioButton {
    color: $Text;
    spacing: 8px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: $TextDisabled;
}

QCheckBox::indicator,
QTreeView::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked,
QTreeView::indicator:unchecked {
    image: url(:/icons/$theme/square_$theme.svg);
}

QCheckBox::indicator:checked,
QTreeView::indicator:checked {
    image: url(:/icons/$theme/square-logo-fill_$theme.svg);
}

QCheckBox::indicator:unchecked:disabled,
QTreeView::indicator:unchecked:disabled {
    image: url(:/icons/$theme/square_disabled.svg);
}

QCheckBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled {
    image: url(:/icons/$theme/square-logo-fill_disabled.svg);
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    image: url(:/icons/$theme/circle_accent.svg);
}

QRadioButton::indicator:checked {
    image: url(:/icons/$theme/radio-button-fill_accent.svg);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/icons/$theme/circle_disabled.svg);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/icons/$theme/radio-button-fill_disabled.svg);
}

/* =========================================================================
   QTabWidget / QTabBar — Onglets
   Design: inactive = $TableHeaderBg + $TextSecondary + $Border
           selected = $InputBg + $Text, bottom border matches pane
   ========================================================================= */

QTabWidget::pane {
    border: 1px solid $Border;
    background: $InputBg;
    top: -1px;
}

/* Details options dock — tab page background matches QGroupBox (QFrame, §14) */
QFrame#detailsOptionsTabPage {
    background: $DockBody;
}

QTabBar::tab {
    background: $TableHeaderBg;
    color: $TextSecondary;
    border: 1px solid $Border;
    padding: 6px 16px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: $InputBg;
    color: $Text;
    border-bottom-color: $InputBg;
}

QTabBar::tab:hover:!selected {
    background: $HoverBg;
}

QTabBar::tab:disabled {
    color: $TextDisabled;
}

/* Close button on tabs (if any) — drawn natively by Fusion */
QTabBar::close-button {
}

QTabBar::close-button:hover {
}

/* =========================================================================
   Dialog tabs — fond spécifique (panneau + onglets)
   Design: $DialogTabBg (Gray800 dark / Gray100 light), distinct des tabs
           générales (docks du main window)
   ========================================================================= */

QDialog QTabWidget::pane {
    background: $DialogTabBg;
}

QDialog QTabBar::tab {
    background: $DialogTabBg;
}

QDialog QTabBar::tab:selected {
    background: $DialogTabBg;
    border-bottom-color: $DialogTabBg;
}

/* =========================================================================
   QGroupBox
   Design: $DockBody background, $Border border, bold title centered at top
   ========================================================================= */

QGroupBox {
    background: $DockBody;
    border: 1px solid $Border;
    border-radius: 4px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 24px 16px 16px 16px;
    color: $Text;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top center;
    padding: 4px 8px;
    font-weight: bold;
    color: $Text;
}

/* QGroupBox without title — used as dock content wrapper via WrapDockContent().
   Smaller padding since there is no title to center. */
QGroupBox#dockContentGroupBox {
    padding: 4px;
}

/* =========================================================================
   QDockWidget — Docks
   Design: custom title bar via ODockTitleBar (setTitleBarWidget),
           $DockBody background, 8px padding around content
   ========================================================================= */

QDockWidget {
    background-color: $DockBody;
    color: $Text;
    padding: 8px;
}

/* Native title bar — hidden, replaced by ODockTitleBar */
QDockWidget::title {
    background: $DockTitle;
    padding: 6px 12px;
    border-bottom: 1px solid $Border;
}

/* =========================================================================
   ODockTitleBar — Custom dock title bar
   Design: $DockTitle background, title left, 3 icon buttons right
   Height: 32px, bottom border separator
   ========================================================================= */

QWidget#dockTitleBar {
    background: $DockTitle;
    min-height: 32px;
}

QLabel#dockTitleLabel {
    color: $Text;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#dockCollapseBtn,
QPushButton#dockDetachBtn,
QPushButton#dockCloseBtn {
    background: transparent;
    border: none;
    border-radius: 2px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 2px;
}

QPushButton#dockCollapseBtn:hover,
QPushButton#dockDetachBtn:hover,
QPushButton#dockCloseBtn:hover {
    background: $HoverBg;
}

/* Collapse — expanded (caret-up, click to collapse) */
QPushButton#dockCollapseBtn {
    image: url(:/icons/$theme/caret-up_$theme.svg);
}
QPushButton#dockCollapseBtn:hover {
    image: url(:/icons/$theme/caret-up_accent.svg);
}
/* Collapse — collapsed (caret-down, click to expand) */
QPushButton#dockCollapseBtn[collapsed="true"] {
    image: url(:/icons/$theme/caret-down_$theme.svg);
}
QPushButton#dockCollapseBtn[collapsed="true"]:hover {
    image: url(:/icons/$theme/caret-down_accent.svg);
}

/* Detach */
QPushButton#dockDetachBtn {
    image: url(:/icons/$theme/copy_$theme.svg);
}
QPushButton#dockDetachBtn:hover {
    image: url(:/icons/$theme/copy_accent.svg);
}
QPushButton#dockDetachBtn:disabled {
    image: url(:/icons/$theme/copy_disabled.svg);
}

/* Close */
QPushButton#dockCloseBtn {
    image: url(:/icons/$theme/x_$theme.svg);
}

/* Presets d'angle (0/90/180/270°) sous les champs de formule angle */
QPushButton#anglePresetBtn0,
QPushButton#anglePresetBtn90,
QPushButton#anglePresetBtn180,
QPushButton#anglePresetBtn270 {
    padding: 2px 8px;
    min-height: 22px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 2px;
}

/* =========================================================================
   QMainWindow::separator — Resize handle entre docks
   ========================================================================= */

QMainWindow::separator {
    background: $Border;
    width: 1px;
    height: 1px;
}

/* =========================================================================
   QScrollBar — Vertical + Horizontal (all-or-nothing rule)
   Design: fine (0.65em), $ToolBar background, $ScrollBarHandle handle, no arrows
   ========================================================================= */

QScrollBar:vertical {
    background-color: $ToolBar;
    width: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical {
    background-color: $ScrollBarHandle;
    min-height: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical:hover {
    background-color: $AccentHover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: $ToolBar;
    height: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal {
    background-color: $ScrollBarHandle;
    min-width: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal:hover {
    background-color: $AccentHover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal {
    background: none;
}

/* =========================================================================
   QProgressBar
   Design: $InputBg background, $Accent chunk, subtle border
   ========================================================================= */

QProgressBar {
    background-color: $InputBg;
    border: 1px solid $Border;
    border-radius: 2px;
    text-align: center;
    color: $Text;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: $Accent;
    border-radius: 1px;
}

/* =========================================================================
   QSplitter — Handle
   ========================================================================= */

QSplitter::handle {
    background-color: $Border;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* =========================================================================
   QGraphicsView — Canvas (zone de dessin)
   Design: $Canvas background, no border
   ========================================================================= */

QGraphicsView {
    background-color: $Canvas;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* =========================================================================
   QScrollArea
   The viewport is a plain QWidget (direct child) — make it transparent so
   the QScrollArea/QMainWindow background shows through.
   ========================================================================= */

QScrollArea {
    border: none;
}

/* No QSS background on viewport — handled by QPalette::Window in vtheme.cpp */

/* =========================================================================
   QLabel — Labels
   Design: transparent background, $Text color
   ========================================================================= */

QLabel {
    color: $Text;
    background: transparent;
    border: none;
}

/* =========================================================================
   QDialogButtonBox
   ========================================================================= */

QDialogButtonBox {
    button-layout: 0;
}

/* =========================================================================
   QDateEdit
   ========================================================================= */

QDateEdit {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 4px 8px;
}

QDateEdit:focus {
    border-color: $InputFocus;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid $InputBorder;
}

QDateEdit::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/$theme/caret-down_$theme.svg);
}

QDateEdit::down-arrow:hover {
    image: url(:/icons/$theme/caret-down_accent.svg);
}

QDateEdit::down-arrow:disabled {
    image: url(:/icons/$theme/caret-down_disabled.svg);
}

/* =========================================================================
   QFontComboBox
   ========================================================================= */

QFontComboBox {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 5px 8px;
}

QFontComboBox:hover {
    border-color: $Accent;
}

QFontComboBox:focus {
    border-color: $InputFocus;
}

QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid $InputBorder;
}

QFontComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/$theme/caret-down_$theme.svg);
}

QFontComboBox::down-arrow:hover {
    image: url(:/icons/$theme/caret-down_accent.svg);
}

QFontComboBox::down-arrow:disabled {
    image: url(:/icons/$theme/caret-down_disabled.svg);
}

/* =========================================================================
   QKeySequenceEdit
   ========================================================================= */

QKeySequenceEdit {
    background-color: $InputBg;
    color: $Text;
    border: 1px solid $InputBorder;
    border-radius: 2px;
    padding: 4px 8px;
}

QKeySequenceEdit:focus {
    border-color: $InputFocus;
}

/* =========================================================================
   WelcomeScreen — #id selectors (see WelcomeScreen.cpp for objectNames)
   ========================================================================= */

QWidget#welcomeScreen {
    background-color: $Window;
}

QLabel#welcomeTitle {
    font-size: 28px;
    font-weight: bold;
    color: $Text;
}

QLabel#welcomeVersion {
    font-size: 13px;
    color: $TextSecondary;
}

QLabel#welcomeSubtitle {
    font-size: 15px;
    color: $TextSecondary;
}

QFrame#welcomeSection {
    background-color: transparent;
    border: none;
}

QLabel#welcomeSectionTitle {
    font-weight: 500;
    color: $Text;
}

QPushButton#welcomeNewBtn {
    background-color: $Accent;
    color: $AccentText;
    border: 1px solid $Accent;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeNewBtn:hover {
    background-color: $AccentHover;
    border-color: $AccentHover;
}

QPushButton#welcomeOpenBtn {
    background-color: $Window;
    color: $Text;
    border: 1px solid $Border;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeOpenBtn:hover {
    background-color: $Accent;
    color: $AccentText;
    border-color: $Accent;
}

QLabel#welcomeRecentLabel {
    color: $TextSecondary;
}

QListWidget#welcomeRecentList {
    background-color: $WelcomeListBg;
    color: $Text;
    border: 1px solid $BorderLight;
    border-radius: 2px;
    outline: none;
}

QListWidget#welcomeRecentList::item {
    background-color: transparent;
    padding: 4px 8px;
}

QListWidget#welcomeRecentList::item:hover {
    background-color: $TableRowHoverBg;
    color: $AccentText;
}

QListWidget#welcomeRecentList::item:selected {
    background-color: $Accent;
    color: $AccentText;
}

QFrame#welcomeSeparator {
    background-color: $Border;
}

QFrame#notesSeparator,
QFrame#formulaSeparator {
    background-color: $Border;
}

/* =========================================================================
   StyleGuide / Features window (dev-only)
   ========================================================================= */

QWidget#styleGuideWindow {
    background-color: $Window;
}

/* =========================================================================
   Dock custom title bars
   Design: use setTitleBarWidget() in C++ (design-system.md §7e).
   QSS targets the #id objectNames set on those custom widgets.
   ========================================================================= */

QWidget#dockTitleBar {
    background: $DockTitle;
    border-bottom: 1px solid $Border;
}

QLabel#dockTitleLabel {
    color: $Text;
    font-weight: bold;
}

QPushButton#dockTitleBtn {
    background: transparent;
    border: none;
    color: $TextSecondary;
    min-width: 20px;
    max-width: 20px;
    padding: 0px;
}

QPushButton#dockTitleBtn:hover {
    color: $Text;
    background: $HoverBg;
}
