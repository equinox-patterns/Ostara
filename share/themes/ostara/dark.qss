/* ── Ostara — generated from palette.json ── */
/* ⚠️  DO NOT EDIT — this file is generated from template.qss.in + palette.json  */
/*     Run: python3 scripts/generate_themes.py share/themes/palette.json            */
/*          share/themes share/themes/generated                                     */
/*                                                                                  */
/* Icons: indicators and arrows use SVG images from /icons/ via dark substitution.
   See design-system.md §6 for QScrollArea viewport (C++ workaround, not QSS). */

/* =========================================================================
   GLOBAL — Police de base (Inter, 15px)
   ========================================================================= */

QWidget {
    font-family: "Inter";
    font-size: 15px;
}

/* =========================================================================
   QToolTip
   ========================================================================= */

QToolTip {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 4px 8px;
    font-size: 13px;
}

/* =========================================================================
   MAIN WINDOW / DIALOG — Fond principal
   ========================================================================= */

QMainWindow,
QDialog {
    background-color: #232323;
}

/* =========================================================================
   QMenuBar — Barre de menus système
   Design: #191919 background, 1px #333333 bottom separator
   ========================================================================= */

QMenuBar {
    background-color: #191919;
    color: #e5e5e5;
    border-bottom: 1px solid #333333;
    padding: 1px 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: rgba(255,255,255,0.05);
}

QMenuBar::item:pressed {
    background-color: rgba(255,255,255,0.08);
}

/* =========================================================================
   QMenu — Menus déroulants
   Design: #232323 background, #983e60 highlight on selected items
   ========================================================================= */

QMenu {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #333333;
    padding: 4px 0px;
}

QMenu::item {
    padding: 5px 30px 5px 12px;
}

QMenu::item:selected {
    background-color: #983e60;
    color: #e5e5e5;
}

QMenu::item:disabled {
    color: #4c4c4c;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* =========================================================================
   QToolBar — Barres d'outils (TopBar, ToolBar latérale, etc.)
   Design: #232323 background, #333333 separators
   ========================================================================= */

QToolBar {
    background-color: #232323;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background: #333333;
    width: 1px;
    margin: 4px 4px;
}

/* =========================================================================
   QStatusBar — Barre de statut
   Design: #191919 background, #7f7f7f for text, 13px labels
   ========================================================================= */

QStatusBar {
    background-color: #191919;
    color: #7f7f7f;
    border-top: 1px solid #333333;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #7f7f7f;
    font-size: 13px;
}

/* =========================================================================
   QPushButton — Boutons standards
   Design: flat, #232323 at rest → #983e60 on hover/pressed/default
   Disabled: #4c4c4c + #4c4c4c
   ========================================================================= */

QPushButton {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton:hover,
QPushButton:pressed,
QPushButton:default {
    background-color: #983e60;
    color: #e5e5e5;
    border-color: #983e60;
}

QPushButton:disabled {
    background-color: #232323;
    color: #4c4c4c;
    border-color: #4c4c4c;
}

/* Variante : bouton icône seule (Phosphor, transparent, sans bordure) */
QPushButton#phosphorIconBtn {
    background: transparent;
    border: none;
    padding: 0px;
    color: #7f7f7f;
}

QPushButton#phosphorIconBtn:hover {
    background: transparent;
    color: #983e60;
}

QPushButton#phosphorIconBtn:pressed {
    background: transparent;
    color: #b75c81;
}

QPushButton#phosphorIconBtn:disabled {
    background: transparent;
    color: #4c4c4c;
}

/* =========================================================================
   QToolButton — Boutons d'outils (toolbar, popup, dialog fx buttons)
   Design: transparent rest → rgba(255,255,255,0.05) hover → rgba(163,58,105,0.18) + #983e60 border when checked
   Variant #drawToolBtn: larger border-radius, rgba(163,58,105,0.18) on hover/checked
   ========================================================================= */

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    color: #7f7f7f;
}

QToolButton:hover {
    background: rgba(255,255,255,0.05);
    color: #e5e5e5;
}

QToolButton:pressed {
    background: rgba(255,255,255,0.08);
}

QToolButton:checked {
    background: rgba(163,58,105,0.18);
    border-color: #983e60;
    color: #e5e5e5;
}

QToolButton:disabled {
    color: #4c4c4c;
}

/* Menu indicator (flèche de popup — VToolButtonPopup) */
QToolButton::menu-indicator {
    image: none;
}

QToolButton::menu-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    width: 16px;
}

QToolButton::menu-button:hover {
    background: rgba(255,255,255,0.05);
}

QToolButton::menu-arrow {
}

/* Variante : bouton toolbar draw (design-system.md §4 — DrawToolBar) */
QToolButton#drawToolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}

QToolButton#drawToolBtn:hover {
    background: rgba(163,58,105,0.18);
}

QToolButton#drawToolBtn:checked {
    background: rgba(163,58,105,0.18);
    border-color: #983e60;
}

QToolButton#drawToolBtn:disabled {
    color: #4c4c4c;
}

/* =========================================================================
   QLineEdit / QPlainTextEdit — Champs texte
   Design: #191919 background, #983e60 border on focus
   Selection: #983e60 + #e5e5e5
   ========================================================================= */

QLineEdit,
QPlainTextEdit {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #983e60;
    selection-color: #e5e5e5;
}

QLineEdit:focus,
QPlainTextEdit:focus {
    border-color: #983e60;
}

QLineEdit:read-only,
QPlainTextEdit:read-only {
    background-color: #232323;
}

QLineEdit:disabled,
QPlainTextEdit:disabled {
    color: #4c4c4c;
    border-color: #4c4c4c;
}

/* =========================================================================
   QSpinBox / QDoubleSpinBox — Champs numériques
   Design: like QLineEdit + custom up/down buttons (all-or-nothing rule)
   ========================================================================= */

QSpinBox,
QDoubleSpinBox {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 4px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #983e60;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #4c4c4c;
    border-color: #4c4c4c;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid #232323;
    border-bottom: 1px solid #232323;
    border-top-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: none;
    border-left: 1px solid #232323;
    border-bottom-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: rgba(255,255,255,0.05);
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: rgba(163,58,105,0.18);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/dark/caret-up_dark.svg);
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url(:/icons/dark/caret-up_accent.svg);
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url(:/icons/dark/caret-up_disabled.svg);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/dark/caret-down_dark.svg);
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url(:/icons/dark/caret-down_accent.svg);
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url(:/icons/dark/caret-down_disabled.svg);
}

/* =========================================================================
   QComboBox — Listes déroulantes (all-or-nothing rule)
   Design: like an input + transparent drop-down + #983e60 hover border
   ========================================================================= */

QComboBox {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 5px 8px;
}

QComboBox:hover {
    border-color: #983e60;
}

QComboBox:focus {
    border-color: #983e60;
}

QComboBox:disabled {
    color: #4c4c4c;
    border-color: #4c4c4c;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #232323;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/dark/caret-down_dark.svg);
}

QComboBox::down-arrow:hover {
    image: url(:/icons/dark/caret-down_accent.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/dark/caret-down_disabled.svg);
}

/* Popup list */
QComboBox QAbstractItemView {
    background-color: #191919;
    color: #e5e5e5;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #191919;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #b75c81;
    color: #e5e5e5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #983e60;
    color: #e5e5e5;
}

/* =========================================================================
   QAbstractItemView — Vues d'items communes (QListWidget, QTreeView, QTableWidget, etc.)
   Design: #191919 background, no borders. Separation by color only.
   Selected → #983e60 + #e5e5e5. Hover → #b75c81.
   ⚠️  Exception QComboBox in cells: hover must be disabled on those rows
       (not expressible in QSS — handled in C++, see design-system.md §3).
   ========================================================================= */

QAbstractItemView {
    background-color: #191919;
    alternate-background-color: #232323;
    color: #e5e5e5;
    border: none;
    outline: none;
    selection-background-color: #983e60;
    selection-color: #e5e5e5;
}

QAbstractItemView::item {
    background-color: #191919;
    border: none;
    padding: 4px 8px;
}

QAbstractItemView::item:alternate {
    background-color: #232323;
}

QAbstractItemView::item:hover {
    background-color: #b75c81;
    color: #e5e5e5;
}

QAbstractItemView::item:selected {
    background-color: #983e60;
    color: #e5e5e5;
}

/* =========================================================================
   QTreeView — Branches (expand/collapse arrows)
   Drawn natively by Fusion — no SVG images
   ========================================================================= */

/* =========================================================================
   QHeaderView — En-têtes de tables / arbres
   Design: #191919 background, no top/left border, subtle right/bottom
   ========================================================================= */

QHeaderView::section {
    background-color: #191919;
    color: #e5e5e5;
    border: none;
    border-right: 1px solid #4c4c4c;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: rgba(255,255,255,0.05);
}

/* =========================================================================
   QCheckBox / QRadioButton
   Design: SVG indicators from /icons/dark/
   ========================================================================= */

QCheckBox,
QRadioButton {
    color: #e5e5e5;
    spacing: 8px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #4c4c4c;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/dark/square_accent.svg);
}

QCheckBox::indicator:checked {
    image: url(:/icons/dark/square-logo-fill_accent.svg);
}

QCheckBox::indicator:unchecked:disabled {
    image: url(:/icons/dark/square_disabled.svg);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/icons/dark/square-logo-fill_disabled.svg);
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    image: url(:/icons/dark/circle_accent.svg);
}

QRadioButton::indicator:checked {
    image: url(:/icons/dark/radio-button-fill_accent.svg);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/icons/dark/circle_disabled.svg);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/icons/dark/radio-button-fill_disabled.svg);
}

/* =========================================================================
   QTabWidget / QTabBar — Onglets
   Design: inactive = #191919 + #7f7f7f + #333333
           selected = #191919 + #e5e5e5, bottom border matches pane
   ========================================================================= */

QTabWidget::pane {
    border: 1px solid #333333;
    background: #191919;
    top: -1px;
}

QTabBar::tab {
    background: #191919;
    color: #7f7f7f;
    border: 1px solid #333333;
    padding: 6px 16px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #191919;
    color: #e5e5e5;
    border-bottom-color: #191919;
}

QTabBar::tab:hover:!selected {
    background: rgba(255,255,255,0.05);
}

QTabBar::tab:disabled {
    color: #4c4c4c;
}

/* Close button on tabs (if any) — drawn natively by Fusion */
QTabBar::close-button {
}

QTabBar::close-button:hover {
}

/* =========================================================================
   QGroupBox
   Design: #232323 background, #333333 border, bold title centered at top
   ========================================================================= */

QGroupBox {
    background: #232323;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 20px 16px 16px 16px;
    font-weight: bold;
    color: #e5e5e5;
}

QGroupBox::title {
    subcontrol-position: top center;
    padding: 0 8px;
    color: #e5e5e5;
}

/* =========================================================================
   QDockWidget — Docks
   Design: #191919 background on native title bar,
           but docks will use custom title bars via setTitleBarWidget()
           (see design-system.md §7e). This QSS is the fallback.
   ========================================================================= */

QDockWidget {
    background-color: #232323;
    color: #e5e5e5;
}

QDockWidget::title {
    background: #191919;
    padding: 6px 12px;
    border-bottom: 1px solid #333333;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 2px;
}

/* =========================================================================
   QMainWindow::separator — Resize handle entre docks
   ========================================================================= */

QMainWindow::separator {
    background: #333333;
    width: 1px;
    height: 1px;
}

/* =========================================================================
   QScrollBar — Vertical + Horizontal (all-or-nothing rule)
   Design: fine (0.65em), #232323 background, #983e60 handle, no arrows
   ========================================================================= */

QScrollBar:vertical {
    background-color: #232323;
    width: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical {
    background-color: #983e60;
    min-height: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical:hover {
    background-color: #b75c81;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #232323;
    height: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal {
    background-color: #983e60;
    min-width: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal:hover {
    background-color: #b75c81;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal {
    background: none;
}

/* =========================================================================
   QProgressBar
   Design: #191919 background, #983e60 chunk, subtle border
   ========================================================================= */

QProgressBar {
    background-color: #191919;
    border: 1px solid #333333;
    border-radius: 2px;
    text-align: center;
    color: #e5e5e5;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #983e60;
    border-radius: 1px;
}

/* =========================================================================
   QSplitter — Handle
   ========================================================================= */

QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* =========================================================================
   QGraphicsView — Canvas (zone de dessin)
   Design: #333333 background, no border
   ========================================================================= */

QGraphicsView {
    background-color: #333333;
    border: none;
}

/* =========================================================================
   QScrollArea
   The viewport is a plain QWidget (direct child) — make it transparent so
   the QScrollArea/QMainWindow background shows through.
   ========================================================================= */

QScrollArea {
    background-color: #232323;
    border: none;
}

QScrollArea > .QWidget {
    background: transparent;
}

/* =========================================================================
   QLabel — Labels
   Design: transparent background, #e5e5e5 color
   ========================================================================= */

QLabel {
    color: #e5e5e5;
    background: transparent;
    border: none;
}

/* =========================================================================
   QDialogButtonBox
   ========================================================================= */

QDialogButtonBox {
    button-layout: 0;
}

/* =========================================================================
   QDateEdit
   ========================================================================= */

QDateEdit {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 4px 8px;
}

QDateEdit:focus {
    border-color: #983e60;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #232323;
}

QDateEdit::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/dark/caret-down_dark.svg);
}

QDateEdit::down-arrow:hover {
    image: url(:/icons/dark/caret-down_accent.svg);
}

QDateEdit::down-arrow:disabled {
    image: url(:/icons/dark/caret-down_disabled.svg);
}

/* =========================================================================
   QFontComboBox
   ========================================================================= */

QFontComboBox {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 5px 8px;
}

QFontComboBox:hover {
    border-color: #983e60;
}

QFontComboBox:focus {
    border-color: #983e60;
}

QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #232323;
}

QFontComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/dark/caret-down_dark.svg);
}

QFontComboBox::down-arrow:hover {
    image: url(:/icons/dark/caret-down_accent.svg);
}

QFontComboBox::down-arrow:disabled {
    image: url(:/icons/dark/caret-down_disabled.svg);
}

/* =========================================================================
   QKeySequenceEdit
   ========================================================================= */

QKeySequenceEdit {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #232323;
    border-radius: 2px;
    padding: 4px 8px;
}

QKeySequenceEdit:focus {
    border-color: #983e60;
}

/* =========================================================================
   WelcomeScreen — #id selectors (see WelcomeScreen.cpp for objectNames)
   ========================================================================= */

QWidget#welcomeScreen {
    background-color: #232323;
}

QLabel#welcomeTitle {
    font-size: 28px;
    font-weight: bold;
    color: #e5e5e5;
}

QLabel#welcomeVersion {
    font-size: 13px;
    color: #7f7f7f;
}

QLabel#welcomeSubtitle {
    font-size: 15px;
    color: #7f7f7f;
}

QFrame#welcomeSection {
    background-color: transparent;
    border: none;
}

QLabel#welcomeSectionTitle {
    font-weight: 500;
    color: #e5e5e5;
}

QPushButton#welcomeNewBtn {
    background-color: #983e60;
    color: #e5e5e5;
    border: 1px solid #983e60;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeNewBtn:hover {
    background-color: #b75c81;
    border-color: #b75c81;
}

QPushButton#welcomeOpenBtn {
    background-color: #232323;
    color: #e5e5e5;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeOpenBtn:hover {
    background-color: #983e60;
    color: #e5e5e5;
    border-color: #983e60;
}

QLabel#welcomeRecentLabel {
    color: #7f7f7f;
}

QListWidget#welcomeRecentList {
    background-color: #191919;
    color: #e5e5e5;
    border: 1px solid #4c4c4c;
    border-radius: 2px;
    outline: none;
}

QListWidget#welcomeRecentList::item {
    background-color: transparent;
    padding: 4px 8px;
}

QListWidget#welcomeRecentList::item:hover {
    background-color: #b75c81;
    color: #e5e5e5;
}

QListWidget#welcomeRecentList::item:selected {
    background-color: #983e60;
    color: #e5e5e5;
}

QFrame#welcomeSeparator {
    background-color: #333333;
}

/* =========================================================================
   StyleGuide / Features window (dev-only)
   ========================================================================= */

QWidget#styleGuideWindow {
    background-color: #232323;
}

/* =========================================================================
   Dock custom title bars
   Design: use setTitleBarWidget() in C++ (design-system.md §7e).
   QSS targets the #id objectNames set on those custom widgets.
   ========================================================================= */

QWidget#dockTitleBar {
    background: #191919;
    border-bottom: 1px solid #333333;
}

QLabel#dockTitleLabel {
    color: #e5e5e5;
    font-weight: bold;
}

QPushButton#dockTitleBtn {
    background: transparent;
    border: none;
    color: #7f7f7f;
    min-width: 20px;
    max-width: 20px;
    padding: 0px;
}

QPushButton#dockTitleBtn:hover {
    color: #e5e5e5;
    background: rgba(255,255,255,0.05);
}
