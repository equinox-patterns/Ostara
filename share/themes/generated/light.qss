/* ── Ostara — Ostara (generated from palette.json) ── */

/* ===== WelcomeScreen ===== */

/* Fond de la fenêtre d'accueil */
QWidget#welcomeScreen {
    background-color: #F5F5F6;
}

/* Titre "Ostara" */
QLabel#welcomeTitle {
    font-size: 32px;
    font-weight: bold;
    color: #303036;
}

/* Numéro de version */
QLabel#welcomeVersion {
    font-size: 12px;
    color: #A0A0A8;
}

/* Sous-titre */
QLabel#welcomeSubtitle {
    font-size: 15px;
    color: #A0A0A8;
}

/* Cartes des sections */
QFrame#welcomeSection {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D8;
    border-radius: 4px;
}

/* Titre de section */
QLabel#welcomeSectionTitle {
    font-size: 13px;
    font-weight: bold;
    color: #303036;
}

/* Bouton "Nouveau" */
QPushButton#welcomeNewBtn {
    background-color: #F5F5F6;
    color: #303036;
    border: 1px solid #D0D0D8;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeNewBtn:hover {
    background-color: #8C4560;
    color: #FFFFFF;
}

/* Bouton "Ouvrir" */
QPushButton#welcomeOpenBtn {
    background-color: #F5F5F6;
    color: #303036;
    border: 1px solid #D0D0D8;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeOpenBtn:hover {
    background-color: #8C4560;
    color: #FFFFFF;
}

/* Label "Récents" */
QLabel#welcomeRecentLabel {
    font-size: 11px;
    color: #A0A0A8;
}

/* Liste des récents */
QListWidget#welcomeRecentList {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D8;
    border-radius: 2px;
}
QListWidget#welcomeRecentList::item {
    padding: 4px 8px;
    color: #303036;
}
QListWidget#welcomeRecentList::item:hover {
    background-color: #ECECEF;
}
QListWidget#welcomeRecentList::item:selected {
    background-color: #8C4560;
    color: #FFFFFF;
}

/* Placeholder Favoris */
QLabel#welcomeFavPlaceholder {
    font-size: 13px;
    color: #A0A0A8;
}
