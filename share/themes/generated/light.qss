/* ── Ostara — generated from palette.json ── */
/* ⚠️  DO NOT EDIT — this file is generated from template.qss.in + palette.json  */
/*     Run: python3 scripts/generate_themes.py share/themes/palette.json            */
/*          share/themes share/themes/generated                                     */
/*                                                                                  */
/* Icons: indicators and arrows use SVG images from /icons/ via light substitution.
   See design-system.md §6 for QScrollArea viewport (C++ workaround, not QSS). */

/* =========================================================================
   GLOBAL — Police de base (Inter, 15px)
   ========================================================================= */

QWidget {
    font-family: "Inter";
    font-size: 15px;
}

/* =========================================================================
   QToolTip
   ========================================================================= */

QToolTip {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 4px 8px;
    font-size: 13px;
}

/* =========================================================================
   MAIN WINDOW / DIALOG — Fond principal
   ========================================================================= */

QMainWindow {
    background-color: #f9f9f9;
}

QDialog {
    background-color: #f9f9f9;
}

/* =========================================================================
   QMenuBar — Barre de menus système
   Design: #e5e5e5 background, 1px #d6d6d6 bottom separator
   ========================================================================= */

QMenuBar {
    background-color: #e5e5e5;
    color: #2b2b2b;
    border-bottom: 1px solid #d6d6d6;
    padding: 1px 0px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: rgba(0,0,0,0.05);
}

QMenuBar::item:pressed {
    background-color: rgba(0,0,0,0.08);
}

/* =========================================================================
   QMenu — Menus déroulants
   Design: #f9f9f9 background, #8C4560 highlight on selected items
   ========================================================================= */

QMenu {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    padding: 4px 0px;
}

QMenu::item {
    padding: 5px 30px 5px 12px;
}

QMenu::item:selected {
    background-color: #8C4560;
    color: #e5e5e5;
}

QMenu::item:disabled {
    color: #7f7f7f;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: #d6d6d6;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* =========================================================================
   QToolBar — Barres d'outils (TopBar, ToolBar latérale, etc.)
   Design: #f4f4f4 background, #d6d6d6 separators
   ========================================================================= */

QToolBar {
    background-color: #f4f4f4;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background: #d6d6d6;
    width: 1px;
    margin: 4px 4px;
}

/* =========================================================================
   QStatusBar — Barre de statut
   Design: #e5e5e5 background, #4c4c4c for text, 13px labels
   ========================================================================= */

QStatusBar {
    background-color: #e5e5e5;
    color: #4c4c4c;
    border-top: 1px solid #d6d6d6;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #4c4c4c;
    font-size: 13px;
    padding-left: 30px;
}

/* =========================================================================
   QPushButton — Boutons standards
   Design: flat, #f9f9f9 at rest → #8C4560 on hover/pressed/default
   Disabled: #7f7f7f + #e5e5e5
   ========================================================================= */

QPushButton {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton:hover,
QPushButton:pressed,
QPushButton:default {
    background-color: #8C4560;
    color: #e5e5e5;
    border-color: #8C4560;
}

QPushButton:disabled {
    background-color: #f9f9f9;
    color: #7f7f7f;
    border-color: #e5e5e5;
}

/* Variante : bouton icône seule (Phosphor, transparent, sans bordure) */
QPushButton#phosphorIconBtn {
    background: transparent;
    border: none;
    padding: 0px;
    color: #4c4c4c;
}

QPushButton#phosphorIconBtn:hover {
    background: transparent;
    color: #8C4560;
}

QPushButton#phosphorIconBtn:pressed {
    background: transparent;
    color: #a85a7a;
}

QPushButton#phosphorIconBtn:disabled {
    background: transparent;
    color: #7f7f7f;
}

/* =========================================================================
   QToolButton — Boutons d'outils (toolbar, popup, dialog fx buttons)
   Design: transparent rest → rgba(0,0,0,0.05) hover → rgba(140,69,96,0.10) + #8C4560 border when checked
   Variant #drawToolBtn: larger border-radius, rgba(140,69,96,0.10) on hover/checked
   ========================================================================= */

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    color: #4c4c4c;
}

QToolButton:hover {
    background: rgba(0,0,0,0.05);
    color: #2b2b2b;
}

QToolButton:pressed {
    background: rgba(0,0,0,0.08);
}

QToolButton:checked {
    background: rgba(140,69,96,0.10);
    border-color: #8C4560;
    color: #2b2b2b;
}

QToolButton:disabled {
    color: #7f7f7f;
}

/* Menu indicator (flèche de popup — VToolButtonPopup) */
QToolButton::menu-indicator {
    image: none;
}

QToolButton::menu-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    width: 16px;
}

QToolButton::menu-button:hover {
    background: rgba(0,0,0,0.05);
}

QToolButton::menu-arrow {
}

/* Variante : bouton toolbar draw (design-system.md §4 — DrawToolBar) */
QToolButton#drawToolBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}

QToolButton#drawToolBtn:hover {
    background: rgba(140,69,96,0.10);
}

QToolButton#drawToolBtn:checked {
    background: rgba(140,69,96,0.10);
    border-color: #8C4560;
}

QToolButton#drawToolBtn:disabled {
    color: #7f7f7f;
}

/* =========================================================================
   QLineEdit / QPlainTextEdit — Champs texte
   Design: #f9f9f9 background, #8C4560 border on focus
   Selection: #8C4560 + #e5e5e5
   ========================================================================= */

QLineEdit,
QPlainTextEdit {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 4px 8px;
    selection-background-color: #8C4560;
    selection-color: #e5e5e5;
}

QLineEdit:focus,
QPlainTextEdit:focus {
    border-color: #8C4560;
}

QLineEdit:read-only,
QPlainTextEdit:read-only {
    background-color: #f9f9f9;
}

QLineEdit:disabled,
QPlainTextEdit:disabled {
    color: #7f7f7f;
    border-color: #e5e5e5;
}

/* =========================================================================
   QSpinBox / QDoubleSpinBox — Champs numériques
   Design: like QLineEdit + custom up/down buttons (all-or-nothing rule)
   ========================================================================= */

QSpinBox,
QDoubleSpinBox {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 4px 8px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #8C4560;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #7f7f7f;
    border-color: #e5e5e5;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border: none;
    border-left: 1px solid #d6d6d6;
    border-bottom: 1px solid #d6d6d6;
    border-top-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: none;
    border-left: 1px solid #d6d6d6;
    border-bottom-right-radius: 2px;
    width: 20px;
    background: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: rgba(0,0,0,0.05);
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: rgba(140,69,96,0.10);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/light/caret-up_light.svg);
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url(:/icons/light/caret-up_accent.svg);
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url(:/icons/light/caret-up_disabled.svg);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
    image: url(:/icons/light/caret-down_light.svg);
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url(:/icons/light/caret-down_accent.svg);
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url(:/icons/light/caret-down_disabled.svg);
}

/* =========================================================================
   #zoomBlock — Glued zoom control [−] [100%] [+]
   ========================================================================= */

#zoomBlockBtnLeft {
    padding: 1px 6px;
    border: 1px solid #d6d6d6;
    border-right: none;
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    background: #f9f9f9;
}

#zoomBlockBtnRight {
    padding: 1px 6px;
    border: 1px solid #d6d6d6;
    border-left: none;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    background: #f9f9f9;
}

#zoomBlockBtnLeft:hover,
#zoomBlockBtnRight:hover {
    background: rgba(0,0,0,0.05);
}

#zoomBlockBtnLeft:pressed,
#zoomBlockBtnRight:pressed {
    background: rgba(0,0,0,0.08);
}

#zoomBlockSpin {
    border: 1px solid #d6d6d6;
    border-left: none;
    border-right: none;
    border-radius: 0;
    background: #f9f9f9;
}

#zoomBlockSpin:focus {
    border-color: #8C4560;
}

/* =========================================================================
   QComboBox — Listes déroulantes (all-or-nothing rule)
   Design: like an input + transparent drop-down + #8C4560 hover border
   ========================================================================= */

QComboBox {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 5px 8px;
}

QComboBox:hover {
    border-color: #8C4560;
}

QComboBox:focus {
    border-color: #8C4560;
}

QComboBox:disabled {
    color: #7f7f7f;
    border-color: #e5e5e5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #d6d6d6;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/light/caret-down_light.svg);
}

QComboBox::down-arrow:hover {
    image: url(:/icons/light/caret-down_accent.svg);
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/light/caret-down_disabled.svg);
}

/* Popup list */
QComboBox QAbstractItemView {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #f4f4f4;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #a85a7a;
    color: #e5e5e5;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #8C4560;
    color: #e5e5e5;
}

/* =========================================================================
   QAbstractItemView — Vues d'items communes (QListWidget, QTreeView, QTableWidget, etc.)
   Design: #f9f9f9 background, no borders. Separation by color only.
   Selected → #8C4560 + #e5e5e5. Hover → #a85a7a.
   ⚠️  Exception QComboBox in cells: hover must be disabled on those rows
       (not expressible in QSS — handled in C++, see design-system.md §3).
   ========================================================================= */

QAbstractItemView {
    background-color: #f9f9f9;
    alternate-background-color: #f9f9f9;
    color: #2b2b2b;
    border: none;
    outline: none;
    selection-background-color: #8C4560;
    selection-color: #e5e5e5;
}

QAbstractItemView::item {
    background-color: #f4f4f4;
    border: none;
    padding: 4px 8px;
}

QAbstractItemView::item:alternate {
    background-color: #f9f9f9;
}

QAbstractItemView::item:hover {
    background-color: #a85a7a;
    color: #e5e5e5;
}

QAbstractItemView::item:selected {
    background-color: #8C4560;
    color: #e5e5e5;
}

/* =========================================================================
   QTreeView — Branches (expand/collapse arrows)
   Drawn natively by Fusion — no SVG images
   ========================================================================= */

/* =========================================================================
   QHeaderView — En-têtes de tables / arbres
   Design: #e5e5e5 background, no top/left border, subtle right/bottom
   ========================================================================= */

QHeaderView::section {
    background-color: #e5e5e5;
    color: #2b2b2b;
    border: none;
    border-right: 1px solid #e5e5e5;
    border-bottom: 1px solid #d6d6d6;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: rgba(0,0,0,0.05);
}

/* =========================================================================
   QCheckBox / QRadioButton
   Design: SVG indicators from /icons/light/
   ========================================================================= */

QCheckBox,
QRadioButton {
    color: #2b2b2b;
    spacing: 8px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #7f7f7f;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/light/square_accent.svg);
}

QCheckBox::indicator:checked {
    image: url(:/icons/light/square-logo-fill_accent.svg);
}

QCheckBox::indicator:unchecked:disabled {
    image: url(:/icons/light/square_disabled.svg);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/icons/light/square-logo-fill_disabled.svg);
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    image: url(:/icons/light/circle_accent.svg);
}

QRadioButton::indicator:checked {
    image: url(:/icons/light/radio-button-fill_accent.svg);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/icons/light/circle_disabled.svg);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/icons/light/radio-button-fill_disabled.svg);
}

/* =========================================================================
   QTabWidget / QTabBar — Onglets
   Design: inactive = #e5e5e5 + #4c4c4c + #d6d6d6
           selected = #f9f9f9 + #2b2b2b, bottom border matches pane
   ========================================================================= */

QTabWidget::pane {
    border: 1px solid #d6d6d6;
    background: #f9f9f9;
    top: -1px;
}

QTabBar::tab {
    background: #e5e5e5;
    color: #4c4c4c;
    border: 1px solid #d6d6d6;
    padding: 6px 16px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #f9f9f9;
    color: #2b2b2b;
    border-bottom-color: #f9f9f9;
}

QTabBar::tab:hover:!selected {
    background: rgba(0,0,0,0.05);
}

QTabBar::tab:disabled {
    color: #7f7f7f;
}

/* Close button on tabs (if any) — drawn natively by Fusion */
QTabBar::close-button {
}

QTabBar::close-button:hover {
}

/* =========================================================================
   Dialog tabs — fond spécifique (panneau + onglets)
   Design: #f4f4f4 (Gray800 dark / Gray100 light), distinct des tabs
           générales (docks du main window)
   ========================================================================= */

QDialog QTabWidget::pane {
    background: #f4f4f4;
}

QDialog QTabBar::tab {
    background: #f4f4f4;
}

QDialog QTabBar::tab:selected {
    background: #f4f4f4;
    border-bottom-color: #f4f4f4;
}

/* =========================================================================
   QGroupBox
   Design: #f4f4f4 background, #d6d6d6 border, bold title centered at top
   ========================================================================= */

QGroupBox {
    background: #f4f4f4;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 24px 16px 16px 16px;
    color: #2b2b2b;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top center;
    padding: 4px 8px;
    font-weight: bold;
    color: #2b2b2b;
}

/* QGroupBox without title — used as dock content wrapper via WrapDockContent().
   Smaller padding since there is no title to center. */
QGroupBox#dockContentGroupBox {
    padding: 4px;
}

/* =========================================================================
   QDockWidget — Docks
   Design: custom title bar via ODockTitleBar (setTitleBarWidget),
           #f4f4f4 background, 8px padding around content
   ========================================================================= */

QDockWidget {
    background-color: #f4f4f4;
    color: #2b2b2b;
    padding: 8px;
}

/* Native title bar — hidden, replaced by ODockTitleBar */
QDockWidget::title {
    background: #e5e5e5;
    padding: 6px 12px;
    border-bottom: 1px solid #d6d6d6;
}

/* =========================================================================
   ODockTitleBar — Custom dock title bar
   Design: #e5e5e5 background, title left, 3 icon buttons right
   Height: 32px, bottom border separator
   ========================================================================= */

QWidget#dockTitleBar {
    background: #e5e5e5;
    min-height: 32px;
}

QLabel#dockTitleLabel {
    color: #2b2b2b;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#dockCollapseBtn,
QPushButton#dockDetachBtn,
QPushButton#dockCloseBtn {
    background: transparent;
    border: none;
    border-radius: 2px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 2px;
}

QPushButton#dockCollapseBtn:hover,
QPushButton#dockDetachBtn:hover,
QPushButton#dockCloseBtn:hover {
    background: rgba(0,0,0,0.05);
}

/* Collapse — expanded (caret-up, click to collapse) */
QPushButton#dockCollapseBtn {
    image: url(:/icons/light/caret-up_light.svg);
}
QPushButton#dockCollapseBtn:hover {
    image: url(:/icons/light/caret-up_accent.svg);
}
/* Collapse — collapsed (caret-down, click to expand) */
QPushButton#dockCollapseBtn[collapsed="true"] {
    image: url(:/icons/light/caret-down_light.svg);
}
QPushButton#dockCollapseBtn[collapsed="true"]:hover {
    image: url(:/icons/light/caret-down_accent.svg);
}

/* Detach */
QPushButton#dockDetachBtn {
    image: url(:/icons/light/copy_light.svg);
}
QPushButton#dockDetachBtn:hover {
    image: url(:/icons/light/copy_accent.svg);
}
QPushButton#dockDetachBtn:disabled {
    image: url(:/icons/light/copy_disabled.svg);
}

/* Close */
QPushButton#dockCloseBtn {
    image: url(:/icons/light/x_light.svg);
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 2px;
}

/* =========================================================================
   QMainWindow::separator — Resize handle entre docks
   ========================================================================= */

QMainWindow::separator {
    background: #d6d6d6;
    width: 1px;
    height: 1px;
}

/* =========================================================================
   QScrollBar — Vertical + Horizontal (all-or-nothing rule)
   Design: fine (0.65em), #f4f4f4 background, #e5e5e5 handle, no arrows
   ========================================================================= */

QScrollBar:vertical {
    background-color: #f4f4f4;
    width: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical {
    background-color: #e5e5e5;
    min-height: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:vertical:hover {
    background-color: #a85a7a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f4f4f4;
    height: 0.65em;
    margin: 0.13em 0.13em 0.13em 0.13em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal {
    background-color: #e5e5e5;
    min-width: 1.5em;
    border-radius: 0.17em;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a85a7a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal {
    background: none;
}

/* =========================================================================
   QProgressBar
   Design: #f9f9f9 background, #8C4560 chunk, subtle border
   ========================================================================= */

QProgressBar {
    background-color: #f9f9f9;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    text-align: center;
    color: #2b2b2b;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #8C4560;
    border-radius: 1px;
}

/* =========================================================================
   QSplitter — Handle
   ========================================================================= */

QSplitter::handle {
    background-color: #d6d6d6;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* =========================================================================
   QGraphicsView — Canvas (zone de dessin)
   Design: #f9f9f9 background, no border
   ========================================================================= */

QGraphicsView {
    background-color: #f9f9f9;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* =========================================================================
   QScrollArea
   The viewport is a plain QWidget (direct child) — make it transparent so
   the QScrollArea/QMainWindow background shows through.
   ========================================================================= */

QScrollArea {
    border: none;
}

/* No QSS background on viewport — handled by QPalette::Window in vtheme.cpp */

/* =========================================================================
   QLabel — Labels
   Design: transparent background, #2b2b2b color
   ========================================================================= */

QLabel {
    color: #2b2b2b;
    background: transparent;
    border: none;
}

/* =========================================================================
   QDialogButtonBox
   ========================================================================= */

QDialogButtonBox {
    button-layout: 0;
}

/* =========================================================================
   QDateEdit
   ========================================================================= */

QDateEdit {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 4px 8px;
}

QDateEdit:focus {
    border-color: #8C4560;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #d6d6d6;
}

QDateEdit::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/light/caret-down_light.svg);
}

QDateEdit::down-arrow:hover {
    image: url(:/icons/light/caret-down_accent.svg);
}

QDateEdit::down-arrow:disabled {
    image: url(:/icons/light/caret-down_disabled.svg);
}

/* =========================================================================
   QFontComboBox
   ========================================================================= */

QFontComboBox {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 5px 8px;
}

QFontComboBox:hover {
    border-color: #8C4560;
}

QFontComboBox:focus {
    border-color: #8C4560;
}

QFontComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background: transparent;
    border: none;
    border-left: 1px solid #d6d6d6;
}

QFontComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/light/caret-down_light.svg);
}

QFontComboBox::down-arrow:hover {
    image: url(:/icons/light/caret-down_accent.svg);
}

QFontComboBox::down-arrow:disabled {
    image: url(:/icons/light/caret-down_disabled.svg);
}

/* =========================================================================
   QKeySequenceEdit
   ========================================================================= */

QKeySequenceEdit {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 4px 8px;
}

QKeySequenceEdit:focus {
    border-color: #8C4560;
}

/* =========================================================================
   WelcomeScreen — #id selectors (see WelcomeScreen.cpp for objectNames)
   ========================================================================= */

QWidget#welcomeScreen {
    background-color: #f9f9f9;
}

QLabel#welcomeTitle {
    font-size: 28px;
    font-weight: bold;
    color: #2b2b2b;
}

QLabel#welcomeVersion {
    font-size: 13px;
    color: #4c4c4c;
}

QLabel#welcomeSubtitle {
    font-size: 15px;
    color: #4c4c4c;
}

QFrame#welcomeSection {
    background-color: transparent;
    border: none;
}

QLabel#welcomeSectionTitle {
    font-weight: 500;
    color: #2b2b2b;
}

QPushButton#welcomeNewBtn {
    background-color: #8C4560;
    color: #e5e5e5;
    border: 1px solid #8C4560;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeNewBtn:hover {
    background-color: #a85a7a;
    border-color: #a85a7a;
}

QPushButton#welcomeOpenBtn {
    background-color: #f9f9f9;
    color: #2b2b2b;
    border: 1px solid #d6d6d6;
    border-radius: 2px;
    padding: 6px 16px;
}

QPushButton#welcomeOpenBtn:hover {
    background-color: #8C4560;
    color: #e5e5e5;
    border-color: #8C4560;
}

QLabel#welcomeRecentLabel {
    color: #4c4c4c;
}

QListWidget#welcomeRecentList {
    background-color: #e5e5e5;
    color: #2b2b2b;
    border: 1px solid #e5e5e5;
    border-radius: 2px;
    outline: none;
}

QListWidget#welcomeRecentList::item {
    background-color: transparent;
    padding: 4px 8px;
}

QListWidget#welcomeRecentList::item:hover {
    background-color: #a85a7a;
    color: #e5e5e5;
}

QListWidget#welcomeRecentList::item:selected {
    background-color: #8C4560;
    color: #e5e5e5;
}

QFrame#welcomeSeparator {
    background-color: #d6d6d6;
}

QFrame#notesSeparator {
    background-color: #d6d6d6;
}

/* =========================================================================
   StyleGuide / Features window (dev-only)
   ========================================================================= */

QWidget#styleGuideWindow {
    background-color: #f9f9f9;
}

/* =========================================================================
   Dock custom title bars
   Design: use setTitleBarWidget() in C++ (design-system.md §7e).
   QSS targets the #id objectNames set on those custom widgets.
   ========================================================================= */

QWidget#dockTitleBar {
    background: #e5e5e5;
    border-bottom: 1px solid #d6d6d6;
}

QLabel#dockTitleLabel {
    color: #2b2b2b;
    font-weight: bold;
}

QPushButton#dockTitleBtn {
    background: transparent;
    border: none;
    color: #4c4c4c;
    min-width: 20px;
    max-width: 20px;
    padding: 0px;
}

QPushButton#dockTitleBtn:hover {
    color: #2b2b2b;
    background: rgba(0,0,0,0.05);
}
