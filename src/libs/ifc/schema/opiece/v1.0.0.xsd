<?xml version="1.0" encoding="UTF-8"?>
<!-- A piece of the library: one block of a pattern, the increments that block uses, and what it needs from the
     pattern it will be imported into.

     This schema is about the envelope, and only the envelope. A piece carries a <draw> and its increments; it
     carries nothing of the pattern it came from — no cartouche, no watermark, no size ranges, no materials, no
     measurement *values*. The measurements its formulas read it does not carry either: it names them, because
     a formula citing `@TP` has to find one, and the pattern that receives the block has to be able to say
     which one its own table does not define. That is what the format says, and that is what this file
     enforces.

     The body of the block is accepted as it stands. It is the very text the .ostara schema validated on the way
     out, and the pattern that receives the block validates it again, against its own schema, at its next save:
     writing the tools a second time here would be a second truth to keep in step with every tool Ostara gains,
     and a tool left out of it would make a piece impossible to save. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:element name="piece">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="version" type="formatVersion"/>
        <xs:element name="unit" type="units"/>
        <xs:element name="increments" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
              <xs:element name="increment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="description" type="xs:string"/>
                  <xs:attribute name="name" type="shortName" use="required"/>
                  <xs:attribute name="formula" type="xs:string"/>
                  <xs:attribute name="type" type="incrementType"/>
                  <xs:attribute name="specialUnits" type="xs:boolean"/>
                  <xs:attribute name="groupId" type="xs:unsignedInt"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="incrementGroups" type="incrementGroupList" minOccurs="0" maxOccurs="1"/>
        <xs:element name="previewCalculations" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
              <xs:element name="increment" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="description" type="xs:string"/>
                  <xs:attribute name="name" type="shortName" use="required"/>
                  <xs:attribute name="formula" type="xs:string"/>
                  <xs:attribute name="type" type="incrementType"/>
                  <xs:attribute name="specialUnits" type="xs:boolean"/>
                  <xs:attribute name="groupId" type="xs:unsignedInt"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="previewCalculationGroups" type="incrementGroupList" minOccurs="0" maxOccurs="1"/>
        <xs:element name="dependencies" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
              <xs:element name="dependency" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="token" type="xs:string" use="required"/>
                  <!-- The block the value comes from — the one that declares the object it is built on.
                       Absent when no block declares it: an operation rebuilds copies that have a value
                       and no element of their own, and naming a block there would be a guess. -->
                  <xs:attribute name="origin" type="xs:string"/>
                  <!-- And when that block IS a library piece, its identity, which survives a rename in
                       the library where a name would not. -->
                  <xs:attribute name="libraryId" type="libraryIdentity"/>
                  <xs:attribute name="category" type="xs:string"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- The measurements the piece reads, named as its own formulas cite them.
             A piece does not carry their values — they come from the measurement table the pattern is opened
             with — so the only thing it can say is which ones it needs. The import asks the table, and names
             the one it does not define rather than let the block draw a value nobody has. -->
        <xs:element name="measurements" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
              <xs:element name="measurement" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="shortName" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- The names the piece gives to its own lines, and the two points each one joins.
             They belong to a pattern's ROOT — outside every block — so a piece that did not carry them would
             lose names its own formulas cite: one real pattern writes `AngleLine_Angle180` in a spline, and
             nothing but this section declares `Angle180`. Imported without it, the formula would resolve to
             nothing, or bind to a line of the host that happens to carry the same name.
             `points` is the ordered pair of point names, separated by a space — the form the pattern writes —
             so a row travels exactly as it stands, and the one the piece has to rename is its pair. -->
        <xs:element name="lineNames" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
              <xs:element name="line" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="points" type="xs:string" use="required"/>
                  <xs:attribute name="name" type="nameSuffix" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="draw" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="##local" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <!-- The name the piece was saved under. It is what the import dialog offers as the name of the
                 instance, and what the reader calls the piece's category once the instance has its own name. -->
            <xs:attribute name="name" type="xs:string" use="required"/>
            <!-- The identity of the library piece: stable across a rename in the library, so that a piece
                 already imported somewhere still knows which piece it came from. -->
            <xs:attribute name="libraryId" type="libraryIdentity" use="required"/>
            <!-- What the reader wrote about the piece, carried by the block it came from. Free text: it is the
                 only thing a piece can say about itself besides its name, and the reader sees it in the library
                 before choosing the piece. -->
            <xs:attribute name="notes" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- A group of increments, one list per table. It carries no increment: membership is written on the
       increment itself, the way a layer carries the group it belongs to. `collapsed` is the reader's own
       state — whether the table shows the group folded — kept with the document the way the layers keep
       theirs. Folding a group enables and disables nothing, so it can never break a formula. -->
  <xs:complexType name="incrementGroupList">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element name="incrementGroup" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:unsignedInt" use="required"/>
          <xs:attribute name="name" type="xs:string"/>
          <xs:attribute name="collapsed" type="xs:boolean"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="formatVersion">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,}\.[0-9]{1,}\.[0-9]{1,}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="units">
    <xs:restriction base="xs:string">
      <xs:enumeration value="mm"/>
      <xs:enumeration value="cm"/>
      <xs:enumeration value="inch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="shortName">
    <xs:restriction base="xs:string">
      <xs:pattern value="([^\p{Nd}\\\p{Zs}*\\/&amp;|!&lt;&gt;^&#10;\()\-−+.,٫, ٬.’=?:;'\\&quot;]){1,1}([^\\\p{Zs}*\\/&amp;|!&lt;&gt;^&#10;\()\-−+.,٫, ٬.’=?:;\\&quot;]){0,}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="incrementType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="increment"/>
      <xs:enumeration value="separator"/>
      <xs:enumeration value="checkWidth"/>
      <xs:enumeration value="checkHeight"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="libraryIdentity">
    <xs:restriction base="xs:string">
      <xs:pattern value="\{[0-9a-fA-F]{8}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{12}\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The name a piece gives to one of its lines. Typed, and not left as a free string, because it becomes a
       token of a formula — `Line_Angle180`, `AngleLine_Angle180` — and a name a formula cannot spell is a name
       nobody can use. Copied from the pattern's schema, which declares the same type: the two schemas are two
       separate documents, and an `xs:include` is impossible here — the schema is loaded from a memory buffer
       with no URI, so a relative `schemaLocation` has nothing to resolve against. The two must agree, and this
       comment is what tells whoever changes one of them. -->
  <xs:simpleType name="nameSuffix">
    <xs:restriction base="xs:string">
      <xs:pattern value="([^\\\p{Zs}*\\/&amp;|!&lt;&gt;^&#10;\()\-−+.,٫, ٬.’=?:;'\\&quot;]){1,1}([^\\\p{Zs}*\\/&amp;|!&lt;&gt;^&#10;\()\-−+.,٫, ٬.’=?:;\\&quot;]){0,}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
