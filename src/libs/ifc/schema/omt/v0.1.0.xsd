<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ox="urn:ostara:omt"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!--
    Ostara Multi-Size Measurements Format v0.1.0
    Stores both the editing recipe (anchor + increments per axis)
    and the computed result grid for O(1) loading.
    Forward-compatible: unknown elements are preserved.
  -->

  <!-- ===== ROOT ===== -->
  <xs:element name="omt">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string" minOccurs="0" maxOccurs="1"/>
        <xs:element name="unit" type="UnitEnum" minOccurs="1" maxOccurs="1"/>
        <xs:element name="system" type="xs:string" minOccurs="0" maxOccurs="1"/>
        <xs:element name="sizeGroups" type="SizeGroupsType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="anchor" type="AnchorType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="measurements" type="MeasurementsType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="grid" type="GridType" minOccurs="0" maxOccurs="1"/>
        <!-- Forward-compat: unknown top-level elements preserved -->
        <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="FormatVersion" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== SIZE GROUPS ===== -->
  <xs:complexType name="SizeGroupsType">
    <xs:sequence>
      <xs:element name="sizeGroup" minOccurs="1" maxOccurs="3">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="values" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== ANCHOR ===== -->
  <xs:complexType name="AnchorType">
    <xs:sequence>
      <xs:element name="bind" minOccurs="1" maxOccurs="3">
        <xs:complexType>
          <xs:attribute name="group" type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== MEASUREMENTS (editing recipe) ===== -->
  <xs:complexType name="MeasurementsType">
    <xs:sequence>
      <xs:element name="m" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="value" type="xs:double" minOccurs="1" maxOccurs="1"/>
            <xs:element name="inc" minOccurs="0" maxOccurs="3">
              <xs:complexType>
                <xs:simpleContent>
                  <xs:extension base="xs:double">
                    <xs:attribute name="group" type="xs:string" use="required"/>
                  </xs:extension>
                </xs:simpleContent>
              </xs:complexType>
            </xs:element>
            <!-- Forward-compat per measurement -->
            <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="name" type="MeasurementName" use="required"/>
          <xs:attribute name="fullName" type="xs:string" use="required"/>
          <xs:attribute name="description" type="xs:string"/>
          <xs:attribute name="type" type="MeasurementTypeEnum" default="measurement"/>
          <xs:attribute name="specialUnits" type="xs:boolean" default="false"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== GRID (computed result) ===== -->
  <xs:complexType name="GridType">
    <xs:sequence>
      <xs:element name="cell" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="m" type="MeasurementName" use="required"/>
          <xs:attribute name="sg" type="xs:string" use="required"/>
          <xs:attribute name="v" type="xs:double" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== SIMPLE TYPES ===== -->

  <xs:simpleType name="FormatVersion">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,}\.[0-9]{1,}\.[0-9]{1,}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UnitEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="mm"/>
      <xs:enumeration value="cm"/>
      <xs:enumeration value="inch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MeasurementTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="measurement"/>
      <xs:enumeration value="separator"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Measurement name: must start with @ -->
  <xs:simpleType name="MeasurementName">
    <xs:restriction base="xs:string">
      <xs:pattern value="@[^\p{Zs}*\\/&amp;|!&lt;&gt;^\n\()\-−+.,٫, ٬.'=?:;&quot;]+"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
