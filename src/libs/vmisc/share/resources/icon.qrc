<RCC>
    <qresource prefix="/">
        <!-- L'icône de fenêtre des dialogues : le logo Ostara, rangé dans share/ qui est versionné. Le chemin de ressource reste :/icon/64x64/icon64x64.png, donc les 75 .ui ne bougent pas. -->
        <file alias="icon/64x64/icon64x64.png">../../../../../share/icons/app/Ostara-64.png</file>
        <!-- L'image de remplacement d'un fond de patron illisible : rangée dans share/, qui est versionné. Le chemin de ressource reste :/icon/svg/broken_path.svg. -->
        <file alias="icon/svg/broken_path.svg">../../../../../share/icons/ui/broken_path.svg</file>

        <!-- Les seules icônes Valentina encore affichées. Tout le reste du dossier a été supprimé. -->
        <file>icon/16x16/roll.png</file>
        <file>icon/16x16/roll@2x.png</file>
        <file>icon/16x16/template.png</file>
        <file>icon/24x24/font_preferences.png</file>
        <file>icon/24x24/font_preferences@2x.png</file>
        <file>icon/32x32/broken_link.png</file>
        <file>icon/32x32/broken_link@2x.png</file>
        <file>icon/32x32/export_to_picture_document.png</file>
        <file>icon/32x32/link.png</file>
        <file>icon/32x32/link@2x.png</file>
        <file>icon/32x32/option_draw.png</file>
    </qresource>
</RCC>
