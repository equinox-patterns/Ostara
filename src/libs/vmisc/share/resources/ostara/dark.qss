/* ── Ostara — Ostara (generated from palette.json) ── */

/* ===== WelcomeScreen ===== */

/* Fond de la fenêtre d'accueil */
QWidget#welcomeScreen {
    background-color: #262627;
}

/* Titre "Ostara" */
QLabel#welcomeTitle {
    font-size: 32px;
    font-weight: bold;
    color: #FFFFFF;
}

/* Numéro de version */
QLabel#welcomeVersion {
    font-size: 12px;
    color: #C2C2C2;
}

/* Sous-titre */
QLabel#welcomeSubtitle {
    font-size: 15px;
    color: #C2C2C2;
}

/* Cartes des sections */
QFrame#welcomeSection {
    background-color: #262627;
    border: 1px solid #3E3E3E;
    border-radius: 4px;
}

/* Titre de section */
QLabel#welcomeSectionTitle {
    font-size: 13px;
    font-weight: bold;
    color: #FFFFFF;
}

/* Bouton "Nouveau" */
QPushButton#welcomeNewBtn {
    background-color: #262627;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeNewBtn:hover {
    background-color: #a33a69;
    color: #FFFFFF;
}

/* Bouton "Ouvrir" */
QPushButton#welcomeOpenBtn {
    background-color: #262627;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    padding: 6px 16px;
    border-radius: 2px;
}
QPushButton#welcomeOpenBtn:hover {
    background-color: #a33a69;
    color: #FFFFFF;
}

/* Label "Récents" */
QLabel#welcomeRecentLabel {
    font-size: 11px;
    color: #C2C2C2;
}

/* Liste des récents */
QListWidget#welcomeRecentList {
    background-color: #262627;
    border: 1px solid #3E3E3E;
    border-radius: 2px;
}
QListWidget#welcomeRecentList::item {
    padding: 4px 8px;
    color: #FFFFFF;
}
QListWidget#welcomeRecentList::item:hover {
    background-color: #323232;
}
QListWidget#welcomeRecentList::item:selected {
    background-color: #a33a69;
    color: #FFFFFF;
}

/* Placeholder Favoris */
QLabel#welcomeFavPlaceholder {
    font-size: 13px;
    color: #C2C2C2;
}
