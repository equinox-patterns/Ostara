<RCC>
    <!-- Les textes de licence, tels quels : deux d'entre eux (MIT et OFL) ne sont valables
         que complets, et les autres n'ont de sens que lisibles. Ils voyagent donc dans le
         binaire — une copie de l'application dont le dossier Resources a été vidé doit
         encore pouvoir dire ce qu'elle doit. -->
    <qresource prefix="/licenses">
        <file alias="GPL-3.0.txt">../../../../../share/licenses/GPL-3.0.txt</file>
        <file alias="GPL-2.0.txt">../../../../../share/licenses/GPL-2.0.txt</file>
        <file alias="phosphor-MIT.txt">../../../../../share/licenses/phosphor-MIT.txt</file>
        <file alias="inter-OFL.txt">../../../../../share/licenses/inter-OFL.txt</file>
        <file alias="clipper2-BSL-1.0.txt">../../../../../share/licenses/clipper2-BSL-1.0.txt</file>
        <file alias="muparser-MIT.txt">../../../../../share/licenses/muparser-MIT.txt</file>
        <file alias="xerces-Apache-2.0.txt">../../../../../share/licenses/xerces-Apache-2.0.txt</file>
        <file alias="LGPL-3.0.txt">../../../../../share/licenses/LGPL-3.0.txt</file>
        <file alias="zlib.txt">../../../../../share/licenses/zlib.txt</file>
        <file alias="graaflib-MIT.txt">../../../../../share/licenses/graaflib-MIT.txt</file>
        <file alias="xerces-NOTICE.txt">../../../../../share/licenses/xerces-NOTICE.txt</file>
    </qresource>
</RCC>
